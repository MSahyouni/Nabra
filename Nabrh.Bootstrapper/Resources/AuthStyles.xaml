<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Card shared by every authentication surface: login, 2FA, verification, change password. -->
  <Style x:Key="AuthCardStyle" TargetType="Border">
    <Setter Property="Width" Value="480" />
    <Setter Property="Padding" Value="{StaticResource HeroCardPadding}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
  </Style>

  <!-- Single-digit OTP cell. Used by TwoFactorPage and VerificationPage. -->
  <Style x:Key="OtpDigitBoxStyle" TargetType="TextBox">
    <Setter Property="Width" Value="52" />
    <Setter Property="Height" Value="60" />
    <Setter Property="Margin" Value="6,0" />
    <Setter Property="MaxLength" Value="1" />
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceTintBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ChipBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <!-- Inline validation message. Uses the status token, never a literal red. -->
  <Style x:Key="AuthErrorTextStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,12,0,0" />
    <Setter Property="Foreground" Value="{DynamicResource StatusRedBrush}" />
  </Style>
</ResourceDictionary>

