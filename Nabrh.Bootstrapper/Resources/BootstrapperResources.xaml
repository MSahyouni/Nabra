<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Application.Resources for the bootstrapper application.

    GovernanceTheme.xaml merges the WPF-UI Themes and Controls dictionaries itself, so
    they must NOT also be merged here: a StaticResource in a merged dictionary cannot
    see sibling dictionaries, only its own merged ones. Listing them here as siblings of
    GovernanceTheme is what broke `BasedOn="{StaticResource {x:Type ui:TextBox}}"` and
    crashed the wizard on the Activation step.

    The pack URIs name the assembly explicitly (";component/") rather than using the
    application-relative form. The short form resolves against the *entry* assembly, which
    happens to be this one today but silently breaks the moment these resources are loaded
    from anywhere else.
  -->
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="pack://application:,,,/Nabrh.Bootstrapper;component/Resources/Converters.xaml" />
    <ResourceDictionary Source="pack://application:,,,/Nabrh.Bootstrapper;component/Resources/GovernanceTheme.xaml" />
  </ResourceDictionary.MergedDictionaries>
</ResourceDictionary>
